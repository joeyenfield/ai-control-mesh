pipeline {
    agent { label 'lan-builder' }
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    // Parameters are maintained by configure.groovy and refresh-versions.py.
    // Declaring static parameters here would overwrite the available-version dropdown.
    stages {
        stage('Validate selection') {
            steps {
                script {
                    if (!params.VERSION || params.VERSION == 'Select a tested distribution') {
                        error('Choose a VERSION from Build with Parameters.')
                    }
                }
            }
        }
        stage('Release tested distribution') {
            steps {
                sh 'python3 -u "$MESH_CI_HOME/release_distribution.py" "$VERSION" --target "$TARGET"'
            }
        }
    }
    post {
        always {
            script {
                if (params.VERSION && params.VERSION != 'Select a tested distribution') {
                    sh 'python3 "$MESH_CI_HOME/jenkins/collect-results.py" release "$VERSION" .'
                    archiveArtifacts artifacts: 'results/**', allowEmptyArchive: true
                }
            }
        }
    }
}
