pipeline {
    agent { label 'lan-builder' }
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }
    stages {
        stage('Checkout branch or PR') {
            steps {
                script {
                    deleteDir()
                    checkout scm
                    sh 'python3 "$MESH_CI_HOME/jenkins/github-status.py" pending'
                }
            }
        }
        stage('Prepare verification containers') {
            steps { sh 'python3 "$MESH_CI_HOME/verify.py" . --stage prepare' }
        }
        stage('Tools unit tests') {
            steps { sh 'python3 "$MESH_CI_HOME/verify.py" . --stage tools' }
        }
        stage('Client unit tests') {
            steps { sh 'python3 "$MESH_CI_HOME/verify.py" . --stage client' }
        }
        stage('Machine unit tests') {
            steps { sh 'python3 "$MESH_CI_HOME/verify.py" . --stage machine' }
        }
        // gofmt, and go vet for every system each module ships for.
        stage('Go formatting and vet') {
            steps { sh 'python3 "$MESH_CI_HOME/verify.py" . --stage vet' }
        }
        // Each in containers of its own, so they run side by side; every one runs even when another fails.
        stage('Suites') {
            failFast false
            parallel {
                stage('Server tests (SQLite)') {
                    steps { sh 'python3 "$MESH_CI_HOME/verify.py" . --stage server' }
                }
                stage('Server tests (PostgreSQL)') {
                    steps { sh 'python3 "$MESH_CI_HOME/verify.py" . --stage server-postgres' }
                }
                // The Python agent, agent-proxy and agent-machine, with the client contract run against them.
                stage('Python programs') {
                    steps { sh 'python3 "$MESH_CI_HOME/verify.py" . --stage python' }
                }
                stage('Helm chart') {
                    steps { sh 'python3 "$MESH_CI_HOME/verify.py" . --stage helm' }
                }
            }
        }
        stage('UI verification') {
            steps { sh 'python3 "$MESH_CI_HOME/verify.py" . --stage ui' }
        }
    }
    post {
        success { sh 'python3 "$MESH_CI_HOME/jenkins/github-status.py" success' }
        unsuccessful {
            script {
                if (fileExists('.git')) {
                    sh 'python3 "$MESH_CI_HOME/jenkins/github-status.py" failure'
                }
            }
        }
    }
}
